[
    {hecate, [
        {api_port, 4445},
        {api_host, {127, 0, 0, 1}},
        {data_dir, "~/.hecate-dev/hecate-daemon"},
        {bootstrap, ["https://boot.macula.io:443"]},
        {realm, <<"io.macula">>},
        {gateway_identity, <<"mri:agent:io.macula/hecate-local">>},
        {managed_identities, [
            <<"mri:agent:io.macula/hecate-local">>
        ]},
        {hardware, #{
            ram_gb => 16,
            cpu_cores => 4,
            gpu => <<"none">>,
            gpu_vram_gb => 0,
            storage_path => <<"/tmp">>
        }}
    ]},

    {reckon_db, [
        {writer_pool_size, 5},
        {reader_pool_size, 5},
        {gateway_pool_size, 1}
    ]},

    {evoq, [
        {event_store_adapter, reckon_evoq_adapter},
        {subscription_adapter, reckon_evoq_adapter},
        {store_id, default_store},
        {consistency, eventual}
    ]},

    {serve_llm, [
        {enabled, true},
        {backend, ollama},
        {ollama_url, "http://localhost:11434"},
        {poll_interval_ms, 300000},
        {status_interval_ms, 30000}
    ]},

    {hecate_api, [
        {http_port, 4445}
    ]},

    {manage_alc, [{enabled, true}]},

    {macula, [
        {cert_path, "priv/cert.pem"},
        {key_path, "priv/key.pem"},
        {tls_mode, development},
        {health_port, 8181},
        {quic_port, 9444}
    ]},

    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
