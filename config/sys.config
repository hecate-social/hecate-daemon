[
    {hecate, [
        {api_port, 4444},
        {api_host, {127, 0, 0, 1}},
        {data_dir, "~/.hecate/hecate-daemon"},
        %% Bootstrap stations — fallback only; the deployed env file
        %% (and prod-start.sh) sets MACULA_RELAYS, which wins. Keep in
        %% sync with macula-demo/topologies/<topology>/generated/realm-relays.txt.
        {bootstrap, ["https://station-be-leuven-centrum.macula.io:4433", "https://station-be-leuven-haasrode.macula.io:4433", "https://station-be-leuven-vaartkom.macula.io:4433"]},
        {mesh_connections, 2},  %% multi-homing: concurrent relay connections
        {realm, <<"io.macula">>},

        %% The daemon's own identity is its keypair (hecate_identity) —
        %% its MRI is anonymous on first boot, then the realm-asserted
        %% owner after a realm join. No hand-typed identity config.

        %% managed_identities: hand-typed child-service MRI strings.
        %% Currently DEAD (no production code reads it; only a test +
        %% guide reference it). Was meant to drive listener fact-
        %% filtering. TODO(realm-rethink step 1.5): remove, or revive
        %% as realm-delegated service capabilities — not config strings.
        {managed_identities, [
            <<"mri:agent:io.macula/hecate-dev">>
            %% Example child services (uncomment/add as needed):
            %% <<"mri:agent:io.macula/hecate-dev/weather">>,
            %% <<"mri:agent:io.macula/hecate-dev/translation">>,
            %% <<"mri:agent:io.macula/hecate-dev/data-api">>
        ]},

        %% Realm-server DID allowlist. Each entry is a DID binary; a
        %% realm server (macula-realm) whose DID is in this list is
        %% allowed to call `{realm}.config.gitops.initiate` on this
        %% node. Populated at boot from `MACULA_REALM_SERVER_DIDS`
        %% (comma-separated env var). Empty list = fail-closed (all
        %% such calls rejected).
        {realm_server_dids, []},

        %% Hardware Configuration (populated by install script)
        %% Used for capability announcements to enable intelligent routing
        {hardware, #{
            ram_gb => 16,
            cpu_cores => 4,
            gpu => <<"none">>,
            gpu_vram_gb => 0,
            storage_path => <<"/bulk0">>
        }}
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% ReckonDB Configuration (Embedded Event Store)
    %% NOTE: Stores are NOT configured here. Each domain starts its own
    %% store via reckon_db_sup:start_store/1 in its supervisor's init/1.
    %% This follows VERTICAL SLICING - domains own their infrastructure.
    %% ═══════════════════════════════════════════════════════════════════
    {reckon_db, [
        %% Global defaults (used if domain doesn't specify)
        {writer_pool_size, 5},
        {reader_pool_size, 5},
        {gateway_pool_size, 1}
        %% NO {stores, [...]} here! Domains start their own stores.
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Evoq Configuration (CQRS Framework)
    %% NOTE: evoq looks for 'event_store_adapter', NOT 'default_adapter'!
    %% Each domain passes store_id in dispatch opts; this is just the fallback.
    %% ═══════════════════════════════════════════════════════════════════
    {evoq, [
        {event_store_adapter, reckon_evoq_adapter},
        {subscription_adapter, reckon_evoq_adapter},
        {store_id, default_store},
        {consistency, eventual}
    ]},

    %% LLM serving config moved to hecate-services/hecate-llm.
    %% The daemon no longer runs the gateway in-process; callers
    %% reach it via macula:call("hecate-llm.*", ...).

    %% ═══════════════════════════════════════════════════════════════════
    %% Hecate API Configuration
    %% ═══════════════════════════════════════════════════════════════════
    {hecate_api, [
        {http_port, 4444}
        %% Socket path resolution (see hecate_api_app:get_socket_path/0):
        %%   1. HECATE_SOCKET_PATH env var (k3s: /run/hecate/daemon.sock)
        %%   2. socket_path config below (if set)
        %%   3. $HOME/.hecate/hecate-daemon/sockets/api.sock (default)
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Application Lifecycle (ALC)
    %% ═══════════════════════════════════════════════════════════════════
    {manage_alc, [
        {enabled, true}
    ]},

    {macula, [
        {cert_path, "priv/cert.pem"},
        {key_path, "priv/key.pem"},
        {tls_mode, development},
        {health_port, 8180},        %% Avoid conflict with other services
        {quic_port, 9443}           %% QUIC listener port

        %% Pubsub Phase 2 cutover (off by default; flip via the
        %% HECATE_PUBSUB_PUBLISHER_SIG env var, or uncomment here):
        %%   ,{pubsub_emit_publisher_sig, true}    %% emit publisher_sig on PUBLISH frames
        %%   ,{pubsub_strict_publisher_sig, true}  %% drop EVENTs whose publisher_sig is invalid
        %% DO NOT enable until every relay (macula-station) is on
        %% macula >= 4.4.0. See macula CHANGELOG 4.4.0-4.4.2 +
        %% macula-station/plans/PLAN_PUBSUB_E2E_SIGNED_EVENTS.md.
    ]},

    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {hecate_plugin_logger, #{}}
            }}
        ]}
    ]}
].
