[
    {hecate, [
        {api_port, 4444},
        {api_host, {127, 0, 0, 1}},
        {data_dir, "~/.hecate"},
        {bootstrap, ["https://boot.macula.io:443"]},
        {realm, <<"io.macula">>},

        %% Hierarchical Identity Configuration
        %% The gateway identity is the root identity for this Hecate instance
        {gateway_identity, <<"mri:agent:io.macula/hecate-dev">>},

        %% Managed identities: gateway + all child service identities
        %% Listeners filter incoming mesh facts against this list (is_my_identity/1)
        %% Add service identities as they are deployed to this gateway
        {managed_identities, [
            <<"mri:agent:io.macula/hecate-dev">>
            %% Example child services (uncomment/add as needed):
            %% <<"mri:agent:io.macula/hecate-dev/weather">>,
            %% <<"mri:agent:io.macula/hecate-dev/translation">>,
            %% <<"mri:agent:io.macula/hecate-dev/data-api">>
        ]},

        %% Hardware Configuration (populated by install script)
        %% Used for capability announcements to enable intelligent routing
        {hardware, #{
            ram_gb => 16,
            cpu_cores => 4,
            gpu => <<"none">>,
            gpu_vram_gb => 0,
            storage_path => <<"/bulk0">>
        }}
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% ReckonDB Configuration (Embedded Event Store)
    %% NOTE: Stores are NOT configured here. Each domain starts its own
    %% store via reckon_db_sup:start_store/1 in its supervisor's init/1.
    %% This follows VERTICAL SLICING - domains own their infrastructure.
    %% ═══════════════════════════════════════════════════════════════════
    {reckon_db, [
        %% Global defaults (used if domain doesn't specify)
        {writer_pool_size, 5},
        {reader_pool_size, 5},
        {gateway_pool_size, 1}
        %% NO {stores, [...]} here! Domains start their own stores.
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Evoq Configuration (CQRS Framework)
    %% NOTE: evoq looks for 'event_store_adapter', NOT 'default_adapter'!
    %% Each domain passes store_id in dispatch opts; this is just the fallback.
    %% ═══════════════════════════════════════════════════════════════════
    {evoq, [
        {event_store_adapter, reckon_evoq_adapter},
        {store_id, default_store},
        {consistency, eventual}
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% LLM Capability Service
    %% ═══════════════════════════════════════════════════════════════════
    {serve_llm, [
        {enabled, true},
        {backend, ollama},
        {ollama_url, "http://localhost:11434"},
        {poll_interval_ms, 300000},      %% 5 minutes
        {status_interval_ms, 30000}      %% 30 seconds for heartbeat
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Hecate API Configuration
    %% ═══════════════════════════════════════════════════════════════════
    {hecate_api, [
        {http_port, 4444},
        %% Unix socket for local TUI communication (zero-config, secure)
        %% Set via HECATE_SOCKET_PATH env var in k3s deployment
        {socket_path, "/run/hecate/daemon.sock"}
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Connector Management (Unix Socket Sidecar)
    %% ═══════════════════════════════════════════════════════════════════
    {manage_connectors, [
        {connectors_dir, "~/.config/hecate/connectors"},
        {default_connector, #{
            id => <<"tui">>,
            name => <<"Hecate TUI">>,
            allowed_routes => all
        }},
        {tcp_listener, true}  %% Keep TCP during transition, set false for socket-only
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Mentor Agents (Decentralized Agent Learning)
    %% ═══════════════════════════════════════════════════════════════════
    {mentor_agents, [
        {enabled, true}
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Application Lifecycle (ALC)
    %% ═══════════════════════════════════════════════════════════════════
    {manage_alc, [
        {enabled, true}
    ]},

    {macula, [
        {cert_path, "priv/cert.pem"},
        {key_path, "priv/key.pem"},
        {tls_mode, development},
        {health_port, 8180},        %% Avoid conflict with other services
        {quic_port, 9443}           %% QUIC listener port
    ]},

    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
