[
    {hecate, [
        {api_port, 4444},
        {api_host, {127, 0, 0, 1}},
        {data_dir, "~/.hecate"},
        {bootstrap, ["https://boot.macula.io:443"]},
        {realm, <<"io.macula">>},

        %% Hierarchical Identity Configuration
        %% The gateway identity is the root identity for this Hecate instance
        {gateway_identity, <<"mri:agent:io.macula/hecate-dev">>},

        %% Managed identities: gateway + all child service identities
        %% Listeners filter incoming mesh facts against this list (is_my_identity/1)
        %% Add service identities as they are deployed to this gateway
        {managed_identities, [
            <<"mri:agent:io.macula/hecate-dev">>
            %% Example child services (uncomment/add as needed):
            %% <<"mri:agent:io.macula/hecate-dev/weather">>,
            %% <<"mri:agent:io.macula/hecate-dev/translation">>,
            %% <<"mri:agent:io.macula/hecate-dev/data-api">>
        ]}
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% ReckonDB Configuration (Embedded Event Store)
    %% NOTE: Stores are NOT configured here. Each domain starts its own
    %% store via reckon_db_sup:start_store/1 in its supervisor's init/1.
    %% This follows VERTICAL SLICING - domains own their infrastructure.
    %% ═══════════════════════════════════════════════════════════════════
    {reckon_db, [
        %% Global defaults (used if domain doesn't specify)
        {writer_pool_size, 5},
        {reader_pool_size, 5},
        {gateway_pool_size, 1}
        %% NO {stores, [...]} here! Domains start their own stores.
    ]},

    %% ═══════════════════════════════════════════════════════════════════
    %% Evoq Configuration (CQRS Framework)
    %% ═══════════════════════════════════════════════════════════════════
    {evoq, [
        {default_adapter, reckon_evoq_adapter},
        {consistency, eventual}
    ]},

    {macula, [
        {cert_path, "priv/cert.pem"},
        {key_path, "priv/key.pem"},
        {tls_mode, development},
        {health_port, 8180},        %% Avoid conflict with other services
        {quic_port, 9443}           %% QUIC listener port
    ]},

    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
