%%% @doc Prod-local: bleeding-edge devtime config with REAL mesh.
%%%
%%% Unlike dev.sys.config (which may default to the in-process mesh
%%% backend for fast CT iteration), prod-local always connects to the
%%% real relay fleet + real realm server. Use this when you're iterating
%%% on mesh-adjacent features (license emission, cross-daemon catch-up,
%%% rewrap-on-rotation) and need the actual network behaviour.
%%%
%%% Separate data dir, ports, and node name let you run prod-local
%%% alongside dev simultaneously — e.g. two daemons on the same host,
%%% one on the inproc backend (dev) and one on the real mesh
%%% (prod-local), useful for ping-ponging a test message across
%%% backends during debugging.
%%% @end
[
    {hecate, [
        {api_port, 4446},
        {api_host, {127, 0, 0, 1}},
        {store_mode, single},
        {data_dir, "~/.hecate-prodlocal/hecate-daemon"},
        %% Bootstrap stations — fallback only; prod-start.sh sets
        %% MACULA_RELAYS from macula-demo's realm-relays.txt, which wins.
        %% Mesh_connections=2 gives multi-homing like prod nodes.
        {bootstrap, [
            "https://station-be-leuven-centrum.macula.io:4433",
            "https://station-be-leuven-haasrode.macula.io:4433",
            "https://station-be-leuven-vaartkom.macula.io:4433"
        ]},
        {mesh_connections, 2},
        {realm, <<"io.macula">>},
        {gateway_identity, <<"mri:agent:io.macula/hecate-prodlocal">>},
        {managed_identities, [
            <<"mri:agent:io.macula/hecate-prodlocal">>
        ]},
        {realm_server_dids, []},
        {hardware, #{
            ram_gb => 16,
            cpu_cores => 4,
            gpu => <<"none">>,
            gpu_vram_gb => 0,
            storage_path => <<"/tmp">>
        }},
        %% Force the real mesh client backend even if an env flips the
        %% default. Prod-local is never an inproc run — that's what dev
        %% is for.
        {mesh_backend, client},
        %% Staleness guard: tighten to 1h for devtime visibility of the
        %% guard behaviour (default 24h is hard to exercise by hand).
        {license_staleness_threshold_ms, 3600000}
    ]},

    {reckon_db, [
        {writer_pool_size, 5},
        {reader_pool_size, 5},
        {gateway_pool_size, 1}
    ]},

    {evoq, [
        {event_store_adapter, reckon_evoq_adapter},
        {subscription_adapter, reckon_evoq_adapter},
        {store_id, default_store},
        {consistency, eventual}
    ]},

    {serve_llm, [
        {enabled, true},
        {backend, ollama},
        {ollama_url, "http://localhost:11434"},
        {poll_interval_ms, 300000},
        {status_interval_ms, 30000}
    ]},

    {hecate_api, [
        {http_port, 4446}
    ]},

    {manage_alc, [{enabled, true}]},

    {macula, [
        {cert_path, "priv/cert.pem"},
        {key_path, "priv/key.pem"},
        {tls_mode, development},
        {health_port, 8182},
        {quic_port, 9445},
        {registry_storage_path, "~/.hecate-prodlocal/hecate-daemon/registry"}
    ]},

    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
