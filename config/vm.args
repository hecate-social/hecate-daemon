## Name of the node (long name for cross-host clustering)
## HECATE_NODE_NAME set by env file, e.g., hecate@beam00.lab
-name ${HECATE_NODE_NAME}

## Cookie for distributed erlang
## HECATE_ERLANG_COOKIE set by env file (shared across cluster)
-setcookie ${HECATE_ERLANG_COOKIE}

## Heartbeat management
-heart

## Interactive code server — required for in-VM plugin loading
-mode interactive

## Enable SMP
-smp auto

## Increase async threads
+A 64

## Increase process limit
+P 1048576

## Increase port limit  
+Q 65536

## Set scheduler bind type
+sbt db

## Enable dirty schedulers
+SDio 32
