[
    {hecate, [
        {api_port, 4456},
        {api_host, {127, 0, 0, 1}},
        {data_dir, "~/.hecate-dev6/hecate-daemon"},
        {bootstrap, ["https://boot.macula.io:4433"]},
        {realm, <<"io.macula">>},
        {gateway_identity, <<"mri:agent:io.macula/hecate-dev6">>},
        {managed_identities, [<<"mri:agent:io.macula/hecate-dev6">>]},
        {hardware, #{
            ram_gb => 16, cpu_cores => 4,
            gpu => <<"none">>, gpu_vram_gb => 0,
            storage_path => <<"/tmp">>
        }}
    ]},

    {reckon_db, [{writer_pool_size, 3}, {reader_pool_size, 3}, {gateway_pool_size, 1}]},
    {evoq, [{event_store_adapter, reckon_evoq_adapter}, {subscription_adapter, reckon_evoq_adapter}, {store_id, default_store}, {consistency, eventual}]},
    {serve_llm, [{enabled, false}]},
    {hecate_api, [{http_port, 4456}]},
    {manage_alc, [{enabled, true}]},

    {macula, [
        {cert_path, "priv/cert.pem"}, {key_path, "priv/key.pem"},
        {tls_mode, development},
        {health_port, 8196}, {quic_port, 9456},
        {registry_storage_path, "~/.hecate-dev6/hecate-daemon/registry"}
    ]},

    {kernel, [{logger_level, info}, {logger, [{handler, default, logger_std_h, #{level => info, formatter => {logger_formatter, #{template => [time, " [", level, "] ", msg, "\n"]}}}}]}]}
].
