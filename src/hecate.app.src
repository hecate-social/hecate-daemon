{application, hecate,
 [{description, "Macula Hecate - Agent sidecar for mesh networking"},
  {vsn, "0.7.7"},
  {registered, [hecate_sup, hecate_store, hecate_identity, hecate_mesh]},
  {mod, {hecate_app, []}},
  {applications,
   [kernel,
    stdlib,
    crypto,
    ssl,
    inets,
    jsx,
    cowboy,
    hackney,
    esqlite,
    quicer,
    gproc,
    msgpack,

    %% Event sourcing stack
    reckon_db,
    reckon_evoq,

    %% Mesh infrastructure (MUST start before domain apps with listeners)
    hecate_mesh

    %% NOTE: Domain apps (guide_*, query_*) are NOT listed here.
    %% hecate_app:start/2 creates the event stores (hecate_event_store,
    %% dev_studio_store). Domain apps subscribe to these stores in their
    %% init/1 callbacks. If domain apps are listed as hecate deps, OTP
    %% starts them BEFORE hecate_app:start/2 runs → subscriptions silently
    %% fail because the store worker pool doesn't exist yet.
    %% Domain apps are started by the release config AFTER hecate.
   ]},
  {env, [
    {api_port, 4444},
    {api_host, {127, 0, 0, 1}},
    {data_dir, "~/.hecate"},
    {bootstrap, ["boot.macula.io:4433"]},
    {realm, <<"io.macula">>}
  ]},
  {modules, []},
  {licenses, ["Apache-2.0"]},
  {links, [
    {"GitHub", "https://github.com/macula-io/macula-hecate"},
    {"Macula", "https://github.com/macula-io/macula"}
  ]}
 ]}.
