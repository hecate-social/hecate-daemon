{application, hecate,
 [{description, "Macula Hecate - Agent sidecar for mesh networking"},
  {vsn, "0.7.7"},
  {registered, [hecate_sup, hecate_store, hecate_identity, hecate_mesh]},
  {mod, {hecate_app, []}},
  {applications,
   [kernel,
    stdlib,
    crypto,
    ssl,
    inets,
    jsx,
    cowboy,
    hackney,
    esqlite,
    quicer,
    gproc,
    msgpack,

    %% Event sourcing stack
    reckon_db,
    reckon_evoq,

    %% Mesh infrastructure (MUST start before domain apps with listeners)
    hecate_mesh,

    %% Node lifecycle (consolidated from 11 apps)
    guide_node_lifecycle,
    query_node_lifecycle
    %% Note: hecate_api depends on hecate, not the other way around
   ]},
  {env, [
    {api_port, 4444},
    {api_host, {127, 0, 0, 1}},
    {data_dir, "~/.hecate"},
    {bootstrap, ["boot.macula.io:4433"]},
    {realm, <<"io.macula">>}
  ]},
  {modules, []},
  {licenses, ["Apache-2.0"]},
  {links, [
    {"GitHub", "https://github.com/macula-io/macula-hecate"},
    {"Macula", "https://github.com/macula-io/macula"}
  ]}
 ]}.
