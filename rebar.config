%%% Root rebar.config for macula-hecate umbrella app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% Umbrella app - no local deps, only external hex/git deps
{deps, [
    %% Event sourcing stack (all published on hex.pm)
    {reckon_db, "1.2.2"},      % Core event store (called directly for embedded instances)
    {reckon_evoq, "1.1.2"},    % Adapter (brings evoq as transitive dependency)

    %% Macula mesh client and NIFs
    {macula, "0.20.5"},
    {macula_nifs, {git, "https://github.com/macula-io/macula-nifs.git", {branch, "main"}}},

    %% HTTP server
    {cowboy, "2.12.0"},

    %% SQLite
    {esqlite, "0.8.8"},

    %% HTTP client
    {hackney, "1.20.1"},

    %% CLI argument parsing
    {getopt, "1.0.3"},

    %% QR code generation
    {qrcode, {git, "https://github.com/komone/qrcode.git", {branch, "master"}}}
]}.

%% Release configuration
{relx, [
    {release, {hecate, "0.1.0"}, [
        %% Event sourcing stack (MUST start first)
        reckon_db,      %% Embedded event store
        evoq,           %% CQRS framework
        reckon_evoq,    %% Adapter

        %% Mesh infrastructure (MUST start before domains with listeners)
        hecate_mesh,

        %% All umbrella apps (command services)
        manage_capabilities,
        manage_reputation,
        manage_social,
        manage_subscriptions,
        manage_identities,
        manage_ucan,

        %% All umbrella apps (query services)
        query_capabilities,
        query_reputation,
        query_social,
        query_subscriptions,
        query_identities,
        query_ucan,

        %% Core hecate app (identity, store, pairing, ucan)
        hecate,

        %% API (starts last, depends on hecate)
        hecate_api,

        %% External deps
        sasl
    ]},

    {mode, dev},
    {dev_mode, true},
    {include_erts, false},

    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {eunit_opts, [
            {dir, "test"},
            {report, {eunit_surefire, [{dir, "_build/test"}]}}
        ]},
        {ct_opts, [
            {sys_config, "config/sys.config"}
        ]}
    ]}
]}.

%% EUnit configuration - exclude performance tests from regular test run
{eunit_opts, [
    {dir, "test"},
    {exclude_module, perf_test_runner}
]}.

{project_plugins, [
    rebar3_ex_doc
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula-hecate">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>}
]}.

{hex, [{doc, ex_doc}]}.

%% Dialyzer configuration
%% Exclude dependencies published without debug_info
{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unknown
    ]},
    {plt_extra_apps, [cowboy, cowlib, ranch, hackney, esqlite, jsx]},
    {exclude_apps, [
        reckon_db,
        reckon_evoq,
        reckon_gater,
        evoq,
        macula,
        quicer,
        khepri,
        ra,
        horus,
        aten,
        seshat,
        gen_batch_server
    ]}
]}.
