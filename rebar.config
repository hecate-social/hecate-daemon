%%% Root rebar.config for macula-hecate umbrella app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% Umbrella app - no local deps, only external hex/git deps
{deps, [
    %% Event sourcing stack (all published on hex.pm)
    {reckon_db, "1.2.3"},      % Core event store (called directly for embedded instances)
    {evoq, "1.3.0"},           % CQRS framework (explicit: auto-generated command_id, idempotency_key)
    {reckon_evoq, "1.1.3"},    % Adapter

    %% Macula mesh client and NIFs
    {macula, "0.20.5"},
    {macula_nifs, {git, "https://github.com/macula-io/macula-nifs.git", {branch, "main"}}},

    %% HTTP server
    {cowboy, "2.12.0"},

    %% SQLite
    {esqlite, "0.8.8"},

    %% HTTP client
    {hackney, "1.20.1"},

    %% CLI argument parsing
    {getopt, "1.0.3"},

    %% QR code generation
    {qrcode, {git, "https://github.com/komone/qrcode.git", {branch, "master"}}},

    %% GeoIP database for geographic restrictions
    {locus, "2.3.12"}
]}.

%% Release configuration
{relx, [
    {release, {hecate, "0.8.0"}, [
        %% Shared utilities (MUST start first - no hecate deps)
        shared,

        %% Event sourcing stack
        reckon_db,      %% Embedded event store
        evoq,           %% CQRS framework
        reckon_evoq,    %% Adapter

        %% Geo-restriction (MUST start before mesh)
        geo_check,      %% Geographic access control

        %% Mesh infrastructure (MUST start before domains with listeners)
        hecate_mesh,

        %% Node lifecycle (2 consolidated apps — was 11 node ops apps)
        guide_node_lifecycle,     %% CMD: identity, capabilities, mesh, subs, UCAN, connectors
        query_node_lifecycle,     %% QRY: 13 tables, 13 projections, 12 queries, 6 mesh listeners

        %% Mentorships (renamed from mentor_agents + query_mentors)
        mentor_llms,              %% CMD: decentralized LLM learning
        query_mentorships,        %% QRY: mentor/learning read models

        %% Venture lifecycle (4 consolidated apps, uses dev_studio_store)
        guide_venture_lifecycle,  %% CMD: inception + discovery (was 3 apps)
        guide_division_alc,       %% CMD: design/plan/gen/test/deploy/monitor/rescue (was 7 apps)

        %% Venture lifecycle (query services)
        query_venture_lifecycle,  %% QRY: ventures + discovered_divisions (was 2 apps)
        query_division_alc,       %% QRY: divisions + 14 domain tables (was 7 apps)

        %% Core hecate app (identity, store, pairing, ucan)
        hecate,

        %% Telemetry and cost tracking
        hecate_telemetry,

        %% LLM capability service
        serve_llm,

        %% API (starts last, depends on hecate)
        hecate_api,

        %% External deps
        sasl
    ]},

    {mode, dev},
    {dev_mode, true},
    {include_erts, false},

    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {eunit_opts, [
            {dir, "test"},
            {report, {eunit_surefire, [{dir, "_build/test"}]}}
        ]},
        {ct_opts, [
            {sys_config, "config/sys.config"}
        ]}
    ]}
]}.

%% EUnit configuration - exclude performance tests from regular test run
{eunit_opts, [
    {exclude_module, perf_test_runner}
]}.

{project_plugins, [
    rebar3_ex_doc
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula-hecate">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>}
]}.

{hex, [{doc, ex_doc}]}.

%% Dialyzer configuration
%% Exclude dependencies published without debug_info
{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unknown
    ]},
    {plt_extra_apps, [cowboy, cowlib, ranch, hackney, esqlite, jsx, locus]},
    {exclude_apps, [
        reckon_db,
        reckon_evoq,
        reckon_gater,
        evoq,
        macula,
        quicer,
        khepri,
        ra,
        horus,
        aten,
        seshat,
        gen_batch_server
    ]}
]}.
