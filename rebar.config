%%% Root rebar.config for macula-hecate umbrella app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% Umbrella app - no local deps, only external hex/git deps
{deps, [
    %% Event sourcing stack (all published on hex.pm)
    {reckon_db, "1.2.3"},      % Core event store (called directly for embedded instances)
    {evoq, "1.3.0"},           % CQRS framework (explicit: auto-generated command_id, idempotency_key)
    {reckon_evoq, "1.1.3"},    % Adapter

    %% Macula mesh client and NIFs
    {macula, "0.20.5"},
    {macula_nifs, {git, "https://github.com/macula-io/macula-nifs.git", {branch, "main"}}},

    %% HTTP server
    {cowboy, "2.12.0"},

    %% SQLite
    {esqlite, "0.8.8"},

    %% HTTP client
    {hackney, "1.20.1"},

    %% CLI argument parsing
    {getopt, "1.0.3"},

    %% QR code generation
    {qrcode, {git, "https://github.com/komone/qrcode.git", {branch, "master"}}},

    %% GeoIP database for geographic restrictions
    {locus, "2.3.12"}
]}.

%% Release configuration
{relx, [
    {release, {hecate, "0.8.0"}, [
        %% Shared utilities (MUST start first - no hecate deps)
        shared,

        %% Event sourcing stack
        reckon_db,      %% Embedded event store
        evoq,           %% CQRS framework
        reckon_evoq,    %% Adapter

        %% Geo-restriction (MUST start before mesh)
        geo_check,      %% Geographic access control

        %% Mesh infrastructure (MUST start before domains with listeners)
        hecate_mesh,

        %% All umbrella apps (command services)
        manage_capabilities,
        manage_reputation,
        manage_social,
        manage_subscriptions,
        manage_identities,
        manage_ucan,
        manage_connectors,    %% Connector lifecycle (Unix socket sidecar)
        mentor_agents,        %% Decentralized agent learning (CMD)
        setup_venture,        %% Venture setup process (inception)
        manage_agents,        %% Agent aggregate (specialists/generalists)
        discover_divisions,   %% Division discovery process (Phase 2)
        design_division,      %% Division design process (Phase 3)
        plan_division,        %% Division plan process (Phase 4)
        generate_division,    %% Division generation process (Phase 5)
        test_division,        %% Division testing process (Phase 6)
        deploy_division,      %% Division deployment process (Phase 6)
        monitor_division,     %% Division monitoring process (Phase 6)
        rescue_division,      %% Division rescue process (Phase 6)
        guide_venture,        %% Venture lifecycle orchestrator (Phase 7)

        %% All umbrella apps (query services)
        query_capabilities,
        query_reputation,
        query_social,
        query_subscriptions,
        query_identities,
        query_ucan,
        query_mentors,        %% Mentor/learning read models (QRY)
        query_ventures,       %% Venture read models
        query_discoveries,    %% Discovery read models (Phase 2)
        query_designs,        %% Design read models (Phase 3)
        query_plans,          %% Plan read models (Phase 4)
        query_generations,    %% Generation read models (Phase 5)
        query_tests,          %% Testing read models (Phase 6)
        query_deployments,    %% Deployment read models (Phase 6)
        query_monitoring,     %% Monitoring read models (Phase 6)
        query_rescues,        %% Rescue read models (Phase 6)

        %% Core hecate app (identity, store, pairing, ucan)
        hecate,

        %% Telemetry and cost tracking
        hecate_telemetry,

        %% LLM capability service
        serve_llm,

        %% API (starts last, depends on hecate)
        hecate_api,

        %% External deps
        sasl
    ]},

    {mode, dev},
    {dev_mode, true},
    {include_erts, false},

    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {eunit_opts, [
            {dir, "test"},
            {report, {eunit_surefire, [{dir, "_build/test"}]}}
        ]},
        {ct_opts, [
            {sys_config, "config/sys.config"}
        ]}
    ]}
]}.

%% EUnit configuration - exclude performance tests from regular test run
{eunit_opts, [
    {exclude_module, perf_test_runner}
]}.

{project_plugins, [
    rebar3_ex_doc
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula-hecate">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>}
]}.

{hex, [{doc, ex_doc}]}.

%% Dialyzer configuration
%% Exclude dependencies published without debug_info
{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unknown
    ]},
    {plt_extra_apps, [cowboy, cowlib, ranch, hackney, esqlite, jsx, locus]},
    {exclude_apps, [
        reckon_db,
        reckon_evoq,
        reckon_gater,
        evoq,
        macula,
        quicer,
        khepri,
        ra,
        horus,
        aten,
        seshat,
        gen_batch_server
    ]}
]}.
