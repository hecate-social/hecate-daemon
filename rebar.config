%%% Root rebar.config for macula-hecate umbrella app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% Umbrella app - no local deps, only external hex/git deps
{deps, [
    %% Event sourcing stack (all published on hex.pm)
    {reckon_db, "2.0.0"},      % Event store (gater 2.x / reckon_gater_types rename)
    {reckon_gater, "2.0.1"},   % Gateway (local-first worker selection)
    {evoq, "1.14.4"},           % CQRS framework (wrong_expected_version shape match)
    {reckon_evoq, "2.0.0"},    % Adapter (consumes renamed reckon_gater_api)

    %% Macula mesh SDK (includes crypto/UCAN/DID/MRI/CBOR NIFs since v1.0.0)
    %% 2.0.0 = ownership-tier topic builders (realm/org/app_fact + _hope)
    %% 2.1.0 = topic validation gate at macula_mesh_client.
    %% 3.0.0 = wire format switched from MessagePack to CBOR (RFC 8949)
    %%         via macula_cbor_nif. WIRE-INCOMPATIBLE with 2.x — every
    %%         relay + every daemon must roll forward together.
    %% 3.6.0 = macula_frame + macula_bolt4 + macula_source_route vendored.
    %% 3.7.0 = macula_peering + macula_diagnostics vendored.
    %% 3.8.0 = macula_station_client (V2 read-side: call, find_records_by_type).
    %% 3.9.0 = macula_station_client put_record + find_record. Required for
    %%         daemons to publish node_record / domain-fact records into
    %%         hecate-station DHTs — the legacy macula_mesh_client wire is
    %%         rejected by the peering listener and writes silently dropped.
    %% 3.10.1 = node_record `kind' field — `<<"daemon">>' for the daemon
    %%          presence announcer so the realm-side topology view fans
    %%          out on `_mesh.daemon.*' instead of `_mesh.station.*'.
    %% 3.11.0 = V2 PARITY Phase 1 — macula_client pool, macula_pubsub
    %%          slice, realm-per-call station_link
    %%          (`macula_station_client` renamed to `macula_station_link';
    %%          subscribe/3 → subscribe/4). Streaming RPC + multi-relay
    %%          pubsub still surfaced through `macula_multi_relay' (V1)
    %%          — pool migration of `hecate_mesh_client' is deferred
    %%          until `find_records_by_type' lands on the pool API.
    %% 3.11.1 = macula_record_cbor:encode/1 accepts atoms. Required so
    %%          announce_daemon_presence's put_record succeeds —
    %%          previously the station's verify path crashed on
    %%          atomized payload keys (hostname, kind, etc.) and
    %%          temporary_relay_failure was returned on every refresh.
    %% 3.12.0 = `peers' opt on macula_record:node_record/4 (overlay
    %%          topology). No-op for daemons — relevant for stations.
    %% 3.12.1 = `macula_station_link:call/5' gated on `peer_node_id'
    %%          (matches `publish/4'). Fixes the silent drop of CALL
    %%          frames sent before the CONNECT/HELLO handshake
    %%          completes — observed as `announce_daemon_presence's
    %%          put_record timing out forever on every refresh, with
    %%          the underlying QUIC connection healthy. Critical for
    %%          daemons to publish `_mesh.daemon.announced_v1` and
    %%          appear in the realm topology view.
    %% 3.13.0 = V2 ADVERTISE/UNADVERTISE wire frames +
    %%          `macula_station_link:advertise/4`. macula-realm
    %%          registers RPC procedures via this surface; the
    %%          daemon's `do_join_with_token' now CALLs the V2 path
    %%          against the station-link pool instead of the V1
    %%          `macula:call/4' that dropped on V2-only relays.
    %% Streaming RPC (call_stream/advertise_stream) shipped in 1.5.x,
    %% still surfaced through macula_multi_relay.
    {macula, "~> 3.13.0"},

    %% HTTP server
    {cowboy, "2.12.0"},

    %% Neuroevolution (snake gladiator breeding)
    {faber_tweann, "~> 1.2"},
    {faber_neuroevolution, "~> 1.2"},
    {faber_nn_nifs, {git, "https://codeberg.org/rgfaber/faber-nn-nifs.git", {tag, "v1.0.0"}}},

    %% Plugin SDK (behaviour + helpers)
    {hecate_sdk, "0.6.1"},

    %% HTTP client
    {hackney, "1.20.1"},

    %% CLI argument parsing
    {getopt, "1.0.3"},

    %% GeoIP database for geographic restrictions
    {locus, "2.3.12"}
]}.

%% Release configuration
{relx, [
    {release, {hecate, "0.18.0"}, [
        %% Shared utilities (MUST start first - no hecate deps)
        shared,

        %% Event sourcing stack
        reckon_db,      %% Embedded event store
        evoq,           %% CQRS framework
        reckon_evoq,    %% Adapter

        %% Tier-0 boot orchestrator: cluster cookie, store spawn,
        %% readiness tracking, post-boot sequencing, pg seam.
        %% MUST start before hecate (tier-1) and any domain apps.
        boot_daemon,

        %% Geo-restriction (MUST start before mesh)
        geo_check,      %% Geographic access control

        %% Mesh infrastructure (MUST start before domains with listeners)
        hecate_mesh,

        %% T3 Edge Relay — optional LAN relay (HECATE_EDGE_RELAY=true to enable)
        hecate_edge_relay,

        %% Core hecate app — MUST start before domain apps!
        %% hecate_app:start/2 creates domain event stores
        %% (settings_store, llm_store, licenses_store, plugins_store). Domain apps subscribe in their init/1 callbacks.
        hecate,

        %% Settings lifecycle (3 apps)
        guide_settings_lifecycle,  %% CMD: identity, preferences
        project_settings,          %% PRJ: settings projections
        query_settings,            %% QRY: settings read endpoints

        %% Realm memberships (3 apps)
        guide_realm_memberships,       %% CMD: initiate, confirm, revoke memberships
        project_realm_memberships,     %% PRJ: memberships SQLite projections
        query_realm_memberships,       %% QRY: list realms, leave realm

        %% Site lifecycle (3 apps) — cluster-level realm membership
        guide_site_lifecycle,          %% CMD: initiate site, join/leave realm, admit/remove nodes
        project_site,                  %% PRJ: site ETS projection
        query_site,                    %% QRY: get site, nodes, realm

        %% LAN discovery — find machines on local network
        discover_lan,

        %% LLM capability service (includes cost tracking)
        serve_llm,
        project_llm_usage,        %% PRJ: LLM usage ETS projection

        %% License offering lifecycle (author side — catalog management)
        guide_license_offering_lifecycle,  %% CMD: initiate/announce/publish/amend/retract/archive offerings
        project_license_offerings,         %% PRJ: offerings ETS projection
        query_license_offerings,           %% QRY: browse offerings, get offering, author listings

        %% License lifecycle (consumer side — buying/granting)
        guide_license_lifecycle,  %% CMD: initiate/accept/buy/grant/revoke/archive licenses
        project_licenses,         %% PRJ: licenses ETS projection
        query_licenses,           %% QRY: get licenses

        %% Phase D share-license lifecycle (content sharing with wrapped CEKs)
        guide_share_license_lifecycle,  %% CMD: issue/accept/end/rewrap share-licenses
        project_share_licenses,          %% PRJ: issuer-side rewrap index (my_issued_realm_scoped_active_licenses)

        %% Procurement lifecycle (walking skeleton)
        guide_procurement_lifecycle,  %% CMD: initiate/archive procurements
        project_procurements,         %% PRJ: procurements ETS projection
        query_procurements,           %% QRY: procurements read endpoints

        %% Sale lifecycle (walking skeleton)
        guide_sale_lifecycle,  %% CMD: initiate/archive sales
        project_sales,         %% PRJ: sales ETS projection
        query_sales,           %% QRY: sales read endpoints

        %% Payment lifecycle (walking skeleton)
        guide_payment_lifecycle,  %% CMD: initiate/archive payments
        project_payments,         %% PRJ: payments ETS projection
        query_payments,           %% QRY: payments read endpoints

        %% Plugin lifecycle (node domain, folded from hecate-app-noded)
        guide_plugin_lifecycle,   %% CMD: install/upgrade/remove plugins + container provisioning
        project_plugins,          %% PRJ: plugins ETS projection
        query_plugins,            %% QRY: list installed plugins

        %% Launcher lifecycle (sidebar layout)
        guide_launcher_lifecycle, %% CMD: initialize/register/unregister/reorganize launcher
        project_launcher,         %% PRJ: launcher ETS projection
        query_launcher,           %% QRY: launcher layout + entries read endpoints

        %% Martha apps moved to hecate-app-martha plugin

        %% MPong game (mesh stress test)
        guide_mpong_game_lifecycle, %% CMD: host/join/start/eliminate/end games
        project_mpong_games,        %% PRJ: game state ETS projection
        query_mpong_games,          %% QRY: game API endpoints

        %% Briefcase (mesh-backed file sharing — killer app)
        guide_briefcase_lifecycle,  %% CMD: upload/revise/move/archive/purge/grant/revoke
        project_briefcase_files,    %% PRJ: files ETS projection
        query_briefcase_files,      %% QRY: file API endpoints

        %% Repos (git-over-mesh — PLAN_GIT_OVER_MESH.md Phases 1 & 2)
        guide_repo_lifecycle,       %% CMD: initiate/rename/set_description/archive
        project_repos,              %% PRJ: repos ETS projection
        query_repos,                %% QRY: catalog read endpoints
        announce_ref_updates,       %% INFRA: post-receive hook socket + FACT publisher
        serve_git_over_mesh,        %% INFRA: bare repo on disk + mesh RPC advertisements

        %% Observer (BEAM diagnostics, read-only introspection)
        query_observer,

        %% Plugin SDK (observability, behaviours, codegen)
        hecate_sdk,

        %% API (starts last, depends on hecate)
        hecate_api,

        %% External deps
        sasl
    ]},

    {mode, dev},
    {dev_mode, true},
    {include_erts, false},

    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {eunit_opts, [
            {dir, "test"},
            {report, {eunit_surefire, [{dir, "_build/test"}]}}
        ]},
        {ct_opts, [
            {sys_config, "config/sys.config"}
        ]}
    ]}
]}.

%% EUnit configuration - exclude performance tests from regular test run
{eunit_opts, [
    {exclude_module, perf_test_runner}
]}.

{project_plugins, [
    rebar3_ex_doc
]}.

{ex_doc, [
    {source_url, <<"https://codeberg.org/macula-io/macula-hecate">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>}
]}.

{hex, [{doc, ex_doc}]}.

%% Dialyzer configuration
%% Exclude dependencies published without debug_info
{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unknown
    ]},
    {plt_extra_apps, [cowboy, cowlib, ranch, hackney, esqlite, locus]},
    {exclude_apps, [
        reckon_db,
        reckon_evoq,
        reckon_gater,
        evoq,
        macula,
        quicer,
        khepri,
        ra,
        horus,
        aten,
        seshat,
        gen_batch_server
    ]}
]}.
