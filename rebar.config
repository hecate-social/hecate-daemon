%%% Root rebar.config for macula-hecate umbrella app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% Umbrella app - no local deps, only external hex/git deps
{deps, [
    %% Event sourcing stack (all published on hex.pm)
    {reckon_db, "1.3.3"},      % Core event store (eager emitter pool for late subscriptions)
    {evoq, "1.5.0"},           % CQRS framework (nested event structure)
    {reckon_evoq, "1.2.3"},    % Adapter (reckon_gater debug_info fix)

    %% Macula mesh client and NIFs
    {macula, "0.20.5"},
    {macula_nifs, {git, "https://github.com/macula-io/macula-nifs.git", {branch, "main"}}},

    %% HTTP server
    {cowboy, "2.12.0"},

    %% SQLite
    {esqlite, "0.8.8"},

    %% Neuroevolution (snake gladiator breeding)
    {faber_tweann, "~> 1.2"},
    {faber_neuroevolution, "~> 1.2"},
    {faber_nn_nifs, {git, "https://github.com/rgfaber/faber-nn-nifs.git", {tag, "v1.0.0"}}},

    %% HTTP client
    {hackney, "1.20.1"},

    %% CLI argument parsing
    {getopt, "1.0.3"},

    %% QR code generation
    {qrcode, {git, "https://github.com/komone/qrcode.git", {branch, "master"}}},

    %% GeoIP database for geographic restrictions
    {locus, "2.3.12"},

    %% YAML parsing (sidebar config, etc.)
    {yamerl, "0.10.0"}
]}.

%% Release configuration
{relx, [
    {release, {hecate, "0.14.0"}, [
        %% Shared utilities (MUST start first - no hecate deps)
        shared,

        %% Event sourcing stack
        reckon_db,      %% Embedded event store
        evoq,           %% CQRS framework
        reckon_evoq,    %% Adapter

        %% Geo-restriction (MUST start before mesh)
        geo_check,      %% Geographic access control

        %% Mesh infrastructure (MUST start before domains with listeners)
        hecate_mesh,

        %% Core hecate app — MUST start before domain apps!
        %% hecate_app:start/2 creates domain event stores
        %% (settings_store, llm_store, mentorships_store, licenses_store,
        %% plugins_store). Domain apps subscribe in their init/1 callbacks.
        hecate,

        %% Settings lifecycle (3 apps)
        guide_settings_lifecycle,  %% CMD: identity, preferences
        project_settings,          %% PRJ: settings projections
        query_settings,            %% QRY: settings read endpoints

        %% Realm memberships (3 apps)
        guide_realm_memberships,       %% CMD: initiate, confirm, revoke memberships
        project_realm_memberships,     %% PRJ: memberships SQLite projections
        query_realm_memberships,       %% QRY: list realms, leave realm

        %% Mentorships (renamed from mentor_agents + query_mentors)
        mentor_llms,              %% CMD: decentralized LLM learning
        project_llm_mentorships,  %% PRJ: mentor/learning SQLite store + projections
        query_llm_mentorships,    %% QRY: mentor/learning read endpoints

        %% LLM capability service (includes cost tracking)
        serve_llm,

        %% License lifecycle (appstore domain, folded from hecate-app-appstored)
        guide_license_lifecycle,  %% CMD: initiate/announce/buy/publish/revoke/archive licenses
        project_licenses,         %% PRJ: catalog + licenses SQLite projections
        query_licenses,           %% QRY: browse catalog, get licenses, plugin details

        %% Plugin lifecycle (node domain, folded from hecate-app-noded)
        guide_plugin_lifecycle,   %% CMD: install/upgrade/remove plugins + container provisioning
        project_plugins,          %% PRJ: plugins SQLite projection
        query_plugins,            %% QRY: list installed plugins

        %% API (starts last, depends on hecate)
        hecate_api,

        %% External deps
        sasl
    ]},

    {mode, dev},
    {dev_mode, true},
    {include_erts, false},

    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {eunit_opts, [
            {dir, "test"},
            {report, {eunit_surefire, [{dir, "_build/test"}]}}
        ]},
        {ct_opts, [
            {sys_config, "config/sys.config"}
        ]}
    ]}
]}.

%% EUnit configuration - exclude performance tests from regular test run
{eunit_opts, [
    {exclude_module, perf_test_runner}
]}.

{project_plugins, [
    rebar3_ex_doc
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula-hecate">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>}
]}.

{hex, [{doc, ex_doc}]}.

%% Dialyzer configuration
%% Exclude dependencies published without debug_info
{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unknown
    ]},
    {plt_extra_apps, [cowboy, cowlib, ranch, hackney, esqlite, locus]},
    {exclude_apps, [
        reckon_db,
        reckon_evoq,
        reckon_gater,
        evoq,
        macula,
        quicer,
        khepri,
        ra,
        horus,
        aten,
        seshat,
        gen_batch_server
    ]}
]}.
