{erl_opts, [debug_info]}.

{deps, [
    {reckon_evoq, "1.1.3"},
    {reckon_db, "1.2.3"}
]}.

%% Include vertical slice subdirectories
{src_dirs, [
    "src",
    %% Identity (2 desks)
    "src/register_identity",
    "src/update_identity",
    %% Capabilities (3 desks + 3 PMs)
    "src/announce_capability",
    "src/update_capability",
    "src/retract_capability",
    "src/on_llm_detected_announce_capability",
    "src/on_llm_removed_retract_capability",
    "src/on_llm_status_reported_update_capability",
    %% Mesh connections (4 desks)
    "src/connect_node",
    "src/disconnect_node",
    "src/endorse_capability",
    "src/revoke_endorsement",
    %% Subscriptions (2 desks)
    "src/subscribe_topic",
    "src/unsubscribe_topic",
    %% UCAN (2 desks)
    "src/grant_ucan",
    "src/revoke_ucan",
    %% Connectors (4 desks + 1 PM + 1 utility)
    "src/register_connector",
    "src/revoke_connector",
    "src/activate_connector",
    "src/suspend_connector",
    "src/on_connector_registered_start_listener",
    "src/scope_connector_routes"
]}.

{shell, [{apps, [guide_node_lifecycle]}]}.
