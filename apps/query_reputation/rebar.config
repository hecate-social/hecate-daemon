{erl_opts, [debug_info]}.

{deps, [
    %% Depend on command service for event schemas
    {manage_reputation, {path, "../manage_reputation"}},

    %% SQLite for read models
    {esqlite, "0.8.8"},

    %% JSON encoding
    {jsx, "3.1.0"}
]}.

%% Include vertical slice subdirectories
{src_dirs, ["src", "src/get_rpc_calls_page", "src/get_disputes_page", "src/get_reputation"]}.

{shell, [
    {apps, [query_reputation]}
]}.
