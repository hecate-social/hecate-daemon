{erl_opts, [debug_info]}.

{deps, [
    %% HTTP server
    {cowboy, "2.12.0"},

    %% JSON encoding
    {jsx, "3.1.0"},

    %% Domain apps
    {manage_capabilities, {path, "../manage_capabilities"}},
    {query_capabilities, {path, "../query_capabilities"}},
    {manage_reputation, {path, "../manage_reputation"}},
    {query_reputation, {path, "../query_reputation"}},
    {manage_social, {path, "../manage_social"}},
    {query_social, {path, "../query_social"}},
    {manage_subscriptions, {path, "../manage_subscriptions"}},
    {query_subscriptions, {path, "../query_subscriptions"}},
    {manage_identities, {path, "../manage_identities"}},
    {query_identities, {path, "../query_identities"}},
    {manage_ucan, {path, "../manage_ucan"}},
    {query_ucan, {path, "../query_ucan"}},
    {manage_connectors, {path, "../manage_connectors"}},
    {mentor_agents, {path, "../mentor_agents"}},
    {query_mentors, {path, "../query_mentors"}},
    {manage_cartwheels, {path, "../manage_cartwheels"}},
    {query_cartwheels, {path, "../query_cartwheels"}},
    {setup_venture, {path, "../setup_venture"}},
    {query_ventures, {path, "../query_ventures"}},
    {discover_divisions, {path, "../discover_divisions"}},
    {query_discoveries, {path, "../query_discoveries"}},
    {design_division, {path, "../design_division"}},
    {query_designs, {path, "../query_designs"}},
    {plan_division, {path, "../plan_division"}},
    {query_plans, {path, "../query_plans"}},
    {generate_division, {path, "../generate_division"}},
    {query_generations, {path, "../query_generations"}},
    {test_division, {path, "../test_division"}},
    {query_tests, {path, "../query_tests"}},
    {deploy_division, {path, "../deploy_division"}},
    {query_deployments, {path, "../query_deployments"}},
    {monitor_division, {path, "../monitor_division"}},
    {query_monitoring, {path, "../query_monitoring"}},
    {rescue_division, {path, "../rescue_division"}},
    {query_rescues, {path, "../query_rescues"}}
]}.

{shell, [{apps, [hecate_api]}]}.
