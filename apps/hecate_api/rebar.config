{erl_opts, [debug_info]}.

{deps, [
    %% HTTP server
    {cowboy, "2.12.0"},

    %% JSON encoding
    {jsx, "3.1.0"},

    %% Node lifecycle (2 consolidated apps)
    {guide_node_lifecycle, {path, "../guide_node_lifecycle"}},
    {query_node_lifecycle, {path, "../query_node_lifecycle"}},
    %% Mentorships (renamed)
    {mentor_llms, {path, "../mentor_llms"}},
    {project_llm_mentorships, {path, "../project_llm_mentorships"}},
    {query_llm_mentorships, {path, "../query_llm_mentorships"}},
    %% Venture lifecycle (4 consolidated apps)
    {guide_venture_lifecycle, {path, "../guide_venture_lifecycle"}},
    {query_venture_lifecycle, {path, "../query_venture_lifecycle"}},
    {guide_division_alc, {path, "../guide_division_alc"}},
    {query_division_alc, {path, "../query_division_alc"}}
]}.

{shell, [{apps, [hecate_api]}]}.
