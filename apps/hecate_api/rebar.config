{erl_opts, [debug_info]}.

{deps, [
    %% HTTP server
    {cowboy, "2.12.0"},

    %% JSON encoding
    {jsx, "3.1.0"},

    %% Mentorships
    {mentor_llms, {path, "../mentor_llms"}},
    {project_llm_mentorships, {path, "../project_llm_mentorships"}},
    {query_llm_mentorships, {path, "../query_llm_mentorships"}},

    %% License lifecycle (appstore)
    {guide_license_lifecycle, {path, "../guide_license_lifecycle"}},
    {project_licenses, {path, "../project_licenses"}},
    {query_licenses, {path, "../query_licenses"}},

    %% Plugin lifecycle (node)
    {guide_plugin_lifecycle, {path, "../guide_plugin_lifecycle"}},
    {project_plugins, {path, "../project_plugins"}},
    {query_plugins, {path, "../query_plugins"}}
]}.

{shell, [{apps, [hecate_api]}]}.
