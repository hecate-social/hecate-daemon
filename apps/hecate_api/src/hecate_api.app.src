{application, hecate_api, [
    {description, "HTTP API gateway for macula-hecate using Cowboy"},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {hecate_api_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        yamerl,
        %% hecate core (must start first for hecate_identity)
        hecate,
        %% Mentorships
        mentor_llms,
        project_llm_mentorships,
        query_llm_mentorships,
        %% LLM
        serve_llm,
        %% License lifecycle (appstore)
        guide_license_lifecycle,
        project_licenses,
        query_licenses,
        %% Plugin lifecycle (node)
        guide_plugin_lifecycle,
        project_plugins,
        query_plugins,
        %% Telemetry
        hecate_telemetry
    ]},
    {env, [
        {http_port, 4444},
        {http_host, "127.0.0.1"},
        %% Unix socket for local TUI communication (optional)
        %% When set, starts additional listener on this socket path
        %% {socket_path, "/run/hecate/daemon.sock"}
        {socket_path, undefined}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
