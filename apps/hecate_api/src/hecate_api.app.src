{application, hecate_api, [
    {description, "HTTP API gateway for macula-hecate using Cowboy"},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {hecate_api_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        %% hecate core (must start first for hecate_identity)
        hecate,
        %% Venture lifecycle (4 consolidated apps)
        guide_venture_lifecycle,
        query_venture_lifecycle,
        guide_division_alc,
        query_division_alc,
        %% Node lifecycle (2 consolidated apps — was 11 node ops apps)
        guide_node_lifecycle,
        query_node_lifecycle,
        %% Mentorships (renamed)
        mentor_llms,
        query_mentorships,
        %% LLM
        serve_llm,
        %% Telemetry
        hecate_telemetry
    ]},
    {env, [
        {http_port, 4444},
        {http_host, "127.0.0.1"},
        %% Unix socket for local TUI communication (optional)
        %% When set, starts additional listener on this socket path
        %% {socket_path, "/run/hecate/daemon.sock"}
        {socket_path, undefined}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
