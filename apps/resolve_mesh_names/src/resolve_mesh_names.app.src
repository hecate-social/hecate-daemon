{application, resolve_mesh_names, [
    {description, "Tier-1 mesh-native naming service. Exposes resolve / watch / describe / verify_trust_chain / backlinks over MRIs and signed records. Push-invalidated cache. Consumed by every Tier-2 wire bridge (serve_dns_over_mesh, serve_https_over_mesh, etc.)."},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {resolve_mesh_names_app, []}},
    {applications, [
        kernel,
        stdlib,
        macula
    ]},
    {env, [
        %% DHT lookup tunables (lookup_via_dht).
        %% Note: macula's find_record/2 enforces its own internal
        %% 5000ms per-call timeout — we don't override that. Our
        %% retry just iterates up to N attempts on
        %% not_found / timeout (the substrate-flake error shapes).
        {dht_lookup_retry_attempts,       3},
        {dht_lookup_retry_delay_ms,       50},
        %% Overall deadline including dedup wait. Generous default
        %% — typical fast path is <100ms; this only matters when
        %% the dedup gen_server is overloaded or the macula SDK
        %% hangs near its 5000ms cap × max_attempts.
        {total_lookup_timeout_ms,         20000},
        %% Trust-chain timeouts (PLAN_RESOLVE_MESH_NAMES_PART1 §7.2).
        {trust_chain_total_timeout_ms,    1500},
        {describe_total_timeout_ms,       2000},
        {watch_setup_timeout_ms,          300},

        %% Cache TTL fallback sweep period (PLAN PART1 §6.3).
        %% Push invalidation is primary; this is the safety net for
        %% entries we missed a push notification for.
        {cache_ttl_sweep_period_ms,       30000},

        %% Trust-chain grace window: how far past not_after a record
        %% may still be accepted (clock-skew tolerance).
        {trust_chain_grace_window_ms,     300000},

        %% Default backlinks page size (PLAN PART1 §4.2).
        {backlinks_page_size,             50},

        %% Whether watch/3 delivers the current value on subscribe.
        %% Lower-surprise default. Advanced callers can opt out.
        {watch_delivers_current_value,    true},

        %% Compiled-in foundation seeds, loaded by trust_anchors at
        %% boot. List of `{RealmId :: binary(), FoundationPubkey :: <<_:32/binary>>}`
        %% tuples. Empty by default — operator config (sys.config or
        %% release overlay) supplies the canonical realms' anchors
        %% (`io.macula', `io.beamcampus'). Without seeds the daemon
        %% boots but every resolve returns `{error, no_trust_root}'
        %% until anchors are installed via `hecate names trust import'
        %% or runtime put.
        {compiled_in_seeds,               []}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"Codeberg", "https://codeberg.org/hecate-social/hecate-daemon"}]}
]}.
