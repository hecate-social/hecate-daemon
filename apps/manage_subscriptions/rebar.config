{erl_opts, [debug_info]}.
{deps, [{reckon_evoq, "1.1.2"}, {reckon_db, "1.2.2"}]}.

%% Include vertical slice subdirectories (src_dirs works with dev_mode)
{src_dirs, [
    "src",
    "src/subscribe",
    "src/unsubscribe",
    "src/record_subscriber",
    "src/record_unsubscriber",
    "src/subscriber_events_listener"
]}.

{shell, [{apps, [manage_subscriptions]}]}.
