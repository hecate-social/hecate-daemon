    {mod, {project_launcher_app, []}},
    {applications, [
        kernel,
        stdlib,
        evoq,
        hecate,
        guide_launcher_lifecycle
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-social/hecate-daemon"}]}
]}.
