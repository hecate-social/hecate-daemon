%%% rebar.config for manage_connectors app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% No deps here - umbrella provides them
{deps, []}.

%% Include vertical slice subdirectories (src_dirs works with dev_mode)
{src_dirs, [
    "src",
    "src/register_connector",
    "src/revoke_connector",
    "src/activate_connector",
    "src/suspend_connector",
    "src/on_connector_registered_start_listener",
    "src/scope_connector_routes",
    "src/list_connectors",
    "src/get_connector"
]}.
