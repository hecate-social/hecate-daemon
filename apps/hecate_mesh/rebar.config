{erl_opts, [debug_info]}.

{deps, [
    %% Macula mesh client
    {macula, "1.4.0"},

    %% Shared utilities (for hecate_api_utils in call_rpc_api)
    {shared, {path, "../shared"}}
]}.

{src_dirs, [
    "src",
    "src/call_rpc",
    "src/discover_mesh_subscribers",
    "src/get_mesh_peers",
    "src/get_mesh_status",
    "src/stream_mesh_events",
    "src/probe_mesh_pubsub",
    "src/probe_mesh_rpc",
    "src/probe_mesh_dht",
    "src/probe_mesh_content",
    "src/announce_mesh_presence",
    "src/prove_mesh_capabilities",
    "src/get_mesh_proof"
]}.

{shell, [{apps, [hecate_mesh]}]}.
