{erl_opts, [debug_info]}.

{deps, [
    %% Macula mesh client. 3.5.0 adds envelope/4 + subject_id for
    %% domain-defined DHT record types (PLAN_DHT_FIRST.md).
    %% 3.6.0 vendored macula_frame + macula_bolt4 + macula_source_route.
    %% 3.7.0 vendored macula_peering + macula_diagnostics.
    %% Root rebar.config pins the same ~> 3.7 — keep in sync.
    {macula, "~> 3.7"},

    %% Shared utilities (for hecate_api_utils in call_rpc_api)
    {shared, {path, "../shared"}},

    %% Self-geolocation for daemon presence announce. geo_check wraps
    %% locus (MaxMind GeoIP DB) and provides public-IP discovery.
    {geo_check, {path, "../geo_check"}}
]}.

{src_dirs, [
    "src",
    "src/call_rpc",
    "src/discover_mesh_subscribers",
    "src/get_mesh_peers",
    "src/get_mesh_status",
    "src/stream_mesh_events",
    "src/probe_mesh_pubsub",
    "src/probe_mesh_rpc",
    "src/probe_mesh_dht",
    "src/announce_mesh_presence",
    "src/prove_mesh_capabilities",
    "src/get_mesh_proof"
]}.

{shell, [{apps, [hecate_mesh]}]}.
