{erl_opts, [debug_info]}.

{deps, [
    %% Macula mesh client. Keep in sync with root rebar.config's
    %% pin (~> 4.4.2 — 4.4.2 carries the subscriber-side publisher_sig
    %% verify cutover; 4.4.10 adds CBOR major-1 + integer-key support
    %% required for mpong's state_broadcast payload).
    {macula, "~> 4.4.10"},

    %% Shared utilities (for hecate_api_utils in call_rpc_api)
    {shared, {path, "../shared"}},

    %% Self-geolocation for daemon presence announce. geo_check wraps
    %% locus (MaxMind GeoIP DB) and provides public-IP discovery.
    {geo_check, {path, "../geo_check"}}
]}.

{src_dirs, [
    "src",
    "src/call_rpc",
    "src/discover_mesh_subscribers",
    "src/get_mesh_peers",
    "src/get_mesh_status",
    "src/stream_mesh_events",
    "src/probe_mesh_pubsub",
    "src/probe_mesh_rpc",
    "src/probe_mesh_dht",
    "src/announce_mesh_presence",
    "src/prove_mesh_capabilities",
    "src/get_mesh_proof"
]}.

{shell, [{apps, [hecate_mesh]}]}.
