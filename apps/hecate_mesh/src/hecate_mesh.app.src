{application, hecate_mesh, [
    {description, "Macula mesh client integration for hecate"},
    {vsn, "0.1.0"},
    {registered, [hecate_mesh_client, hecate_mesh_publisher]},
    {mod, {hecate_mesh_app, []}},
    {applications, [
        kernel,
        stdlib,
        macula
    ]},
    {env, [
        %% Config is read from hecate app env (see sys.config):
        %% - hecate.bootstrap
        %% - hecate.realm
        %% - hecate.gateway_identity
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
