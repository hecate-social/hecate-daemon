%%% rebar.config for serve_llm app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% No deps here - umbrella provides them
{deps, []}.

%% Include vertical slice subdirectories
{src_dirs, [
    "src",
    "src/llm_backend",
    "src/announce_llm_capability",
    "src/retract_llm_capability",
    "src/update_llm_status",
    "src/poll_llm_models",
    "src/handle_llm_rpc"
]}.
