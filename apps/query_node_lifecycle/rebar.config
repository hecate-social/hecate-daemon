{erl_opts, [debug_info]}.

{deps, [
    {guide_node_lifecycle, {path, "../guide_node_lifecycle"}},
    {esqlite, "0.8.8"},
    {jsx, "3.1.0"}
]}.

%% Include vertical slice subdirectories
{src_dirs, [
    "src",
    %% Projection desks (13)
    "src/identity_registered_v1_to_identities",
    "src/identity_updated_v1_to_identities",
    "src/capability_announced_v1_to_capabilities",
    "src/capability_updated_v1_to_capabilities",
    "src/capability_retracted_v1_to_capabilities",
    "src/node_connected_v1_to_connections",
    "src/node_disconnected_v1_to_connections",
    "src/capability_endorsed_v1_to_endorsements",
    "src/endorsement_revoked_v1_to_endorsements",
    "src/topic_subscribed_v1_to_subscriptions",
    "src/topic_unsubscribed_v1_to_subscriptions",
    "src/ucan_granted_v1_to_ucan_grants",
    "src/ucan_revoked_v1_to_ucan_grants",
    %% Mesh listeners (6)
    "src/remote_identities_listener",
    "src/remote_capabilities_listener",
    "src/mesh_connection_listener",
    "src/mesh_endorsement_listener",
    "src/mesh_subscription_listener",
    "src/mesh_ucan_listener",
    %% Query desks (12)
    "src/get_identities_page",
    "src/find_identity",
    "src/get_capabilities_page",
    "src/get_capability_by_mri",
    "src/get_connections_page",
    "src/get_connected_nodes",
    "src/get_endorsements_by_node",
    "src/get_mesh_graph",
    "src/get_subscriptions_page",
    "src/get_subscription_stats",
    "src/find_ucan_grants",
    "src/verify_ucan",
    "src/measure_remote_latency"
]}.

{shell, [{apps, [query_node_lifecycle]}]}.
