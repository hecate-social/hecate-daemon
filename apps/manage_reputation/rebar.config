{erl_opts, [debug_info]}.

{deps, [
    %% Evoq adapter for ReckonDB
    {reckon_evoq, "1.1.2"},

    %% ReckonDB (called directly for embedded instances)
    {reckon_db, "1.2.2"}
]}.

%% Include vertical slice subdirectories (src_dirs works with dev_mode)
{src_dirs, [
    "src",
    "src/track_rpc_call",
    "src/flag_dispute",
    "src/resolve_dispute",
    "src/record_dispute_against_me",
    "src/record_dispute_resolution",
    "src/dispute_events_listener"
]}.

{shell, [
    {apps, [manage_reputation]}
]}.
