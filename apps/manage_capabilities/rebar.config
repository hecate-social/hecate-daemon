%%% rebar.config for manage_capabilities app
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% No deps here - umbrella provides them
{deps, []}.

%% Include vertical slice subdirectories (src_dirs works with dev_mode)
{src_dirs, [
    "src",
    "src/announce_capability",
    "src/update_capability",
    "src/retract_capability"
]}.
