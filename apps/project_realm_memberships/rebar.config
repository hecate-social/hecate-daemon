{erl_opts, [debug_info]}.

{deps, [
    {guide_realm_memberships, {path, "../guide_realm_memberships"}},
    {esqlite, "0.8.8"}
]}.

%% Include vertical slice subdirectories
{src_dirs, [
    "src",
    "src/realm_membership_initiated",
    "src/realm_membership_confirmed",
    "src/realm_membership_revoked"
]}.

{shell, [{apps, [project_realm_memberships]}]}.
