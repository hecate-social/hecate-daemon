{erl_opts, [debug_info]}.
{deps, [{reckon_evoq, "1.1.2"}, {reckon_db, "1.2.2"}]}.

%% Include vertical slice subdirectories (src_dirs works with dev_mode)
{src_dirs, [
    "src",
    "src/grant_capability",
    "src/revoke_capability",
    "src/receive_capability",
    "src/receive_capability_revocation",
    "src/ucan_events_listener"
]}.

{shell, [{apps, [manage_ucan]}]}.
