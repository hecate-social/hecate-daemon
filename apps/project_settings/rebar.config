{erl_opts, [debug_info]}.

{deps, [
    {guide_settings_lifecycle, {path, "../guide_settings_lifecycle"}},
    {esqlite, "0.8.8"}
]}.

%% Include vertical slice subdirectories
{src_dirs, [
    "src",
    "src/settings_initiated",
    "src/preferences_updated"
]}.

{shell, [{apps, [project_settings]}]}.
