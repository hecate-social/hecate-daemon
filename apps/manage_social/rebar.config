{erl_opts, [debug_info]}.

{deps, [
    {reckon_evoq, "1.1.2"},
    {reckon_db, "1.2.2"}
]}.

%% Include vertical slice subdirectories (src_dirs works with dev_mode)
{src_dirs, [
    "src",
    "src/follow_agent",
    "src/unfollow_agent",
    "src/endorse_capability",
    "src/revoke_endorsement",
    "src/record_follower",
    "src/record_unfollower",
    "src/record_endorsement",
    "src/record_endorsement_revoked",
    "src/follower_events_listener",
    "src/endorsement_events_listener"
]}.

{shell, [{apps, [manage_social]}]}.
